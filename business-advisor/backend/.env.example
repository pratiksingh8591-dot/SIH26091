# Copy this file to .env and update values if needed.
# DEMO / VERIFY WITH OFFICIAL SOURCE

# Application settings
APP_NAME=Business Advisor API

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database connection (optional for MVP)
# Set this to enable database features for caching and storing analysis results
# Example: postgresql://user:password@localhost:5432/business_advisor
DATABASE_URL=

# Overpass API endpoint for OpenStreetMap data
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_FALLBACK_URLS=https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter
OVERPASS_USER_AGENT=SIH26091-BusinessAdvisor/1.0 (contact: maintainers@example.invalid)
